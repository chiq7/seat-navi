{
  "name": "tixrepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:search": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/searchCoverage.test.mts ./scripts/searchVenueCatalog.test.mts ./scripts/artistSeatGuide.test.mts",
    "typecheck:crawler": "tsc --project tsconfig.scripts.json",
    "test:crawler-safety": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/officialNews/safety.test.mts ./scripts/officialNews/discovery.test.mjs ./scripts/officialNews/eventSync.test.mts",
    "test:artist-platform": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/artistPlatform.test.mts",
    "test:metadata": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/metadata.test.mts",
    "test:structured-data": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/structuredData.test.mts",
    "test:official-tours": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/officialTourSources.test.mts",
    "test:external-seats": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/externalSeats.test.mts",
    "test:venue-seat-locator": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/tokyoDomeSeatLocator.test.mts",
    "test:venue-guide": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/tokyoDomeVisitorGuide.test.mts",
    "generate:kyocera-render-data": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/generateKyoceraRenderData.mts",
    "test:arena-patterns": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/arenaInferenceV3.test.mts",
    "benchmark:arena-patterns": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/arenaPatternBenchmark.mts",
    "test:x-fan-candidates": "node --test --experimental-test-isolation=none --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/xFanCandidates.test.mts",
    "collect:x-fan-candidates": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/collectXFanCandidates.mts",
    "render:x-fan-candidate-review": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/renderXFanCandidateReview.mts",
    "discover:official-news:pending": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/discoverPendingOfficialNews.mts",
    "backfill:event-artists": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/backfill-event-artist-slugs.mts",
    "sync:official-news-events": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/syncOfficialNewsEvents.mts",
    "sync:official-tours": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/syncOfficialTourSources.mts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build && npm run prepare:cloudflare-sitemap && npm run prepare:cloudflare-venue",
    "prepare:cloudflare-sitemap": "node --experimental-strip-types --import ./scripts/ts-loader.mjs ./scripts/prepareCloudflareSitemap.mts",
    "prepare:cloudflare-venue": "node --experimental-strip-types ./scripts/prepareCloudflareVenue.mts",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vinext/cloudflare": "1.3.3",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "openai": "^6.21.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.28",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "postcss": "latest",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vite-css-modules": "latest"
  },
  "type": "module"
}
